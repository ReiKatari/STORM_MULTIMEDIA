# STORM MULTIMEDIA — Шаблон переменных окружения
PORT=3900
HOST=0.0.0.0
DB_PATH=./storm_multimedia.db

# MariaDB 10 / MySQL (необязательно — при отсутствии используется локальная SQLite)
DB_HOST=127.0.0.1
DB_HOST_FALLBACK=
DB_PORT=3306
DB_USER=storm_user
DB_PASS=your_mariadb_password_here
DB_NAME=stormmultimedia

# Portainer Docker API (для скрипта деплоя scripts/sync-portainer.js)
PORTAINER_HOST=127.0.0.1
PORTAINER_PORT=9000
PORTAINER_USER=admin
PORTAINER_PASSWORD=your_portainer_password_here

# Внешние ключи метаданных (необязательно)
TMDB_API_KEY=your_tmdb_api_key_here

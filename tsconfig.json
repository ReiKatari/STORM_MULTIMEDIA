{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "server.js",
    "db.js",
    "mariadb.js",
    "services/**/*.js",
    "routes/**/*.js",
    "middlewares/**/*.js",
    "sockets/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "android_build",
    "dist"
  ]
}